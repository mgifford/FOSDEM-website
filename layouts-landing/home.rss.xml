{{- $pages := where .Site.RegularPages "Section" "news" -}}
{{- $pages = $pages.ByDate.Reverse -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}{{- $pages = first $limit $pages -}}{{- end -}}
{{- $rfc822 := "Mon, 02 Jan 2006 15:04:05 -0700" -}}
{{- printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <link>{{ .Site.Params.FeedHome }}</link>
    <atom:link href="{{ with .OutputFormats.Get "rss" }}{{ .Permalink }}{{ end }}" rel="self" type="application/rss+xml"/>
    <title>{{ .Site.Title }}</title>
    <description>{{ .Site.Params.FeedDescription }}</description>
    {{- with (index $pages 0) }}
    <lastBuildDate>{{ .Date.Format $rfc822 | safeHTML }}</lastBuildDate>
    <pubDate>{{ .Date.Format $rfc822 | safeHTML }}</pubDate>
    {{- end }}
    <ttl>1800</ttl>
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <guid>{{ .Permalink }}</guid>
      <pubDate>{{ .Date.Format $rfc822 | safeHTML }}</pubDate>
      <link>{{ .Permalink }}</link>
      <description>{{ .Content | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>

