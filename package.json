{
  "name": "fosdem-website-a11y",
  "private": true,
  "description": "Accessibility tests (Playwright + axe-core) for the FOSDEM Hugo site",
  "scripts": {
    "build:local": "BASE=http://127.0.0.1:8080/FOSDEM-website/ scripts/build-pages.sh",
    "test:a11y": "playwright test",
    "build:vsr": "esbuild node_modules/@guidepup/virtual-screen-reader/lib/esm/index.browser.js --bundle --format=iife --global-name=GuidepupVSR --outfile=tests/.build/vsr.js --define:process.env.NODE_ENV=\\\"production\\\"",
    "pretest:a11y": "npm run build:vsr"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@guidepup/virtual-screen-reader": "0.32.1",
    "@playwright/test": "^1.55.0",
    "esbuild": "^0.28.2"
  }
}
